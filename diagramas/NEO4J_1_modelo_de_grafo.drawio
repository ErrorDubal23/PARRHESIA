<mxfile><diagram name="Modelo de grafo"><mxGraphModel><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c2" value="&lt;b&gt;Neo4j 1 · Modelo de grafo de propiedades&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#1F3B6F;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry" /></mxCell><mxCell id="c3" value="&lt;b&gt;:Usuario&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#DCE8FA;strokeColor=#1F3B6F;strokeWidth=2.5;fontSize=15;" vertex="1" parent="1"><mxGeometry x="225" y="405" width="150" height="150" as="geometry" /></mxCell><mxCell id="c4" value="id (único)&lt;br&gt;nombre_usuario&lt;br&gt;estado&lt;br&gt;creado_en" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="210" y="559" width="180" height="72" as="geometry" /></mxCell><mxCell id="c5" value="&lt;b&gt;:Publicacion&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFE7A8;strokeColor=#B8860B;strokeWidth=2.5;fontSize=15;" vertex="1" parent="1"><mxGeometry x="825" y="405" width="150" height="150" as="geometry" /></mxCell><mxCell id="c6" value="id (único)&lt;br&gt;estado&lt;br&gt;creado_en (índice)" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="810" y="559" width="180" height="54" as="geometry" /></mxCell><mxCell id="c7" value="&lt;b&gt;:Etiqueta&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#EAF5EA;strokeColor=#3C8A3C;strokeWidth=2.5;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1425" y="125" width="150" height="150" as="geometry" /></mxCell><mxCell id="c8" value="nombre (único)" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1410" y="279" width="180" height="18" as="geometry" /></mxCell><mxCell id="c9" value="&lt;b&gt;:Figura&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#F6E1E5;strokeColor=#8F1D2C;strokeWidth=2.5;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1425" y="445" width="150" height="150" as="geometry" /></mxCell><mxCell id="c10" value="id (único)&lt;br&gt;nombre_completo" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1410" y="599" width="180" height="36" as="geometry" /></mxCell><mxCell id="c11" value="&lt;b&gt;:Serie&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#E8E4F5;strokeColor=#4B3C8F;strokeWidth=2.5;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1425" y="765" width="150" height="150" as="geometry" /></mxCell><mxCell id="c12" value="codigo (único)&lt;br&gt;indicador" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1410" y="919" width="180" height="36" as="geometry" /></mxCell><mxCell id="c13" value="PUBLICO" style="endArrow=block;endFill=1;html=1;strokeColor=#4A5568;strokeWidth=2;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#1F3B6F;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="REACCIONO {tipo, en}" style="endArrow=block;endFill=1;html=1;strokeColor=#4A5568;strokeWidth=2;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#1F3B6F;exitX=0.85;exitY=0.15;entryX=0.15;entryY=0.15;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="330" /></Array></mxGeometry></mxCell><mxCell id="c15" value="MENCIONA" style="endArrow=block;endFill=1;html=1;strokeColor=#4A5568;strokeWidth=2;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#1F3B6F;exitX=0.15;exitY=0.85;entryX=0.85;entryY=0.85;" edge="1" parent="1" source="c5" target="c3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="640" /></Array></mxGeometry></mxCell><mxCell id="c16" value="SIGUE {desde}" style="endArrow=block;endFill=1;html=1;strokeColor=#4A5568;strokeWidth=2;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#1F3B6F;exitX=0.2;exitY=0.1;entryX=0.8;entryY=0.1;" edge="1" parent="1" source="c3" target="c3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="250" /><mxPoint x="430" y="250" /></Array></mxGeometry></mxCell><mxCell id="c17" value="RESPONDE_A" style="endArrow=block;endFill=1;html=1;strokeColor=#4A5568;strokeWidth=2;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#1F3B6F;exitX=0.2;exitY=0.1;entryX=0.8;entryY=0.1;" edge="1" parent="1" source="c5" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="250" /><mxPoint x="1000" y="250" /></Array></mxGeometry></mxCell><mxCell id="c18" value="COMPARTE" style="endArrow=block;endFill=1;html=1;strokeColor=#4A5568;strokeWidth=2;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#1F3B6F;exitX=0.2;exitY=0.95;entryX=0.8;entryY=0.95;" edge="1" parent="1" source="c5" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="780" y="760" /><mxPoint x="1020" y="760" /></Array></mxGeometry></mxCell><mxCell id="c19" value="ETIQUETADA_CON" style="endArrow=block;endFill=1;html=1;strokeColor=#4A5568;strokeWidth=2;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#1F3B6F;exitX=0.95;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="MENCIONA" style="endArrow=block;endFill=1;html=1;strokeColor=#4A5568;strokeWidth=2;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#1F3B6F;exitX=1;exitY=0.55;entryX=0;entryY=0.5;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="VERIFICADA_CON {conclusion, version}" style="endArrow=block;endFill=1;html=1;strokeColor=#4A5568;strokeWidth=2;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#1F3B6F;exitX=0.9;exitY=0.85;entryX=0;entryY=0.5;" edge="1" parent="1" source="c5" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="&lt;b&gt;Reglas&lt;/b&gt;&lt;br&gt;· PostgreSQL es la fuente de verdad: Neo4j es una proyección de la red y solo lo escribe el servicio de grafo, a partir del outbox.&lt;br&gt;· No guarda correos, contraseñas, textos de publicaciones ni etiquetas políticas: solo identificadores, nombres públicos, fechas y estados.&lt;br&gt;· Una publicación retirada no se borra del grafo (estado = retirada): se conserva su árbol de difusión.&lt;br&gt;· VERIFICADA_CON guarda la conclusión vigente; una versión vieja que llegue tarde no pisa a una más nueva.&lt;br&gt;· Restricciones de unicidad en Usuario.id, Publicacion.id, Etiqueta.nombre, Figura.id y Serie.codigo; índice en Publicacion.creado_en." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFF6DD;strokeColor=#C5A56A;" vertex="1" parent="1"><mxGeometry x="40" y="1020" width="980" height="146" as="geometry" /></mxCell><mxCell id="c23" value="&lt;b&gt;Las cuatro consultas que justifican el grafo&lt;/b&gt;&lt;br&gt;1. &lt;b&gt;Feed:&lt;/b&gt; (yo)-[:SIGUE]-&gt;()-[:PUBLICO]-&gt;(p) y a dos saltos, últimos 7 días&lt;br&gt;2. &lt;b&gt;A quién seguir:&lt;/b&gt; (yo)-[:SIGUE]-&gt;(amigo)-[:SIGUE]-&gt;(sugerido), por amigos en común&lt;br&gt;3. &lt;b&gt;Difusión:&lt;/b&gt; (original)&amp;lt;-[:COMPARTE*1..10]-(c): quién compartió a quién&lt;br&gt;4. &lt;b&gt;Tendencias por diversidad:&lt;/b&gt; autores de una etiqueta que NO se siguen entre sí pesan más&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;diversidad = 1 − enlaces / (n·(n−1)); puntaje = publicaciones × diversidad" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFFFFF;strokeColor=#BBBBBB;" vertex="1" parent="1"><mxGeometry x="1060" y="1020" width="760" height="131" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>