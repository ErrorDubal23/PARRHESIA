y x="2272" y="1498" width="96" height="30" as="geometry" /></mxCell><mxCell id="c193" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="c11" target="c192"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c194" value="resumen" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EAF5EA;strokeColor=#3C8A3C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2171" y="1553" width="96" height="30" as="geometry" /></mxCell><mxCell id="c195" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="c11" target="c194"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c196" value="texto" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EAF5EA;strokeColor=#3C8A3C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2140" y="1451" width="96" height="30" as="geometry" /></mxCell><mxCell id="c197" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="c11" target="c196"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c198" value="publicado_en" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EAF5EA;strokeColor=#3C8A3C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2087" y="1219" width="112" height="30" as="geometry" /></mxCell><mxCell id="c199" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="c11" target="c198"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c200" value="huella" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EAF5EA;strokeColor=#3C8A3C;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="2392" y="1271" width="96" height="30" as="geometry" /></mxCell><mxCell id="c201" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="c11" target="c200"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c202" value="&lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EAF5EA;strokeColor=#3C8A3C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3117" y="1365" width="96" height="30" as="geometry" /></mxCell><mxCell id="c203" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="c12" target="c202"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c204" value="nombre" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EAF5EA;strokeColor=#3C8A3C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3043" y="1471" width="96" height="30" as="geometry" /></mxCell><mxCell id="c205" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="c12" target="c204"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c206" value="url_sitio" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EAF5EA;strokeColor=#3C8A3C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2905" y="1501" width="96" height="30" as="geometry" /></mxCell><mxCell id="c207" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="c12" target="c206"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c208" value="canal" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EAF5EA;strokeColor=#3C8A3C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2786" y="1444" width="96" height="30" as="geometry" /></mxCell><mxCell id="c209" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="c12" target="c208"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c210" value="url_canal" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EAF5EA;strokeColor=#3C8A3C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2905" y="1229" width="96" height="30" as="geometry" /></mxCell><mxCell id="c211" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="c12" target="c210"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c212" value="habilitado" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EAF5EA;strokeColor=#3C8A3C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3042" y="1259" width="98" height="30" as="geometry" /></mxCell><mxCell id="c213" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="c12" target="c212"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c214" value="&lt;b&gt;Reglas que el diagrama no muestra por sí solo&lt;/b&gt;&lt;br&gt;· Una publicación es original, respuesta o compartida, nunca las dos cosas; solo una compartida puede no tener texto.&lt;br&gt;· Nadie se sigue a sí mismo ni sigue dos veces a la misma persona. Una reacción por usuario y publicación (se puede cambiar el tipo).&lt;br&gt;· Reacciones: solo &quot;me gusta&quot; y &quot;útil&quot; (decisión 3). A los usuarios nunca se les asigna partido; a las figuras públicas sí, porque es público.&lt;br&gt;· Una publicación no se edita ni se borra: solo se retira. Los contadores (atributos derivados) los mantienen triggers.&lt;br&gt;· La contraseña solo se guarda como huella bcrypt o argon2id. Correo y nombre de usuario son únicos, en minúsculas.&lt;br&gt;· Una tendencia necesita al menos 3 autores con cuentas de más de 7 días. Cada ventana queda guardada (solo inserción).&lt;br&gt;· Un tema necesita al menos 3 medios distintos; título y etiqueta sin cifras. La IA agrupa; la base cuenta, descarta y ordena.&lt;br&gt;· La cita de una declaración reportada aparece textual en el artículo y tiene al menos una cifra. Se liga a una figura solo si el nombre coincide exactamente.&lt;br&gt;· Cada declaración la registra un verificador o administrador (registrada_por, en el MR)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFF6DD;strokeColor=#C5A56A;" vertex="1" parent="1"><mxGeometry x="40" y="1710" width="900" height="251" as="geometry" /></mxCell><mxCell id="c215" value="&lt;b&gt;Notación de Chen&lt;/b&gt;&lt;br&gt;Rectángulo: entidad · Rombo: relación · Elipse: atributo&lt;br&gt;&lt;u&gt;Subrayado&lt;/u&gt;: identificador · Elipse punteada: atributo derivado (lo calcula la base) · Doble elipse: atributo multivaluado&lt;br&gt;Doble rectángulo: entidad débil · Doble rombo: relación que la identifica · Subrayado punteado: clave parcial&lt;br&gt;Borde punteado: entidad detallada en otro MER&lt;br&gt;(mín,máx) junto a una entidad: en cuántas relaciones de ese tipo participa cada ejemplar de esa entidad" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFFFFF;strokeColor=#BBBBBB;" vertex="1" parent="1"><mxGeometry x="980" y="1710" width="760" height="131" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>