<mxfile><diagram name="PostgreSQL a Neo4j"><mxGraphModel><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c2" value="&lt;b&gt;Neo4j 2 · De PostgreSQL a Neo4j (transactional outbox)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#1F3B6F;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="40" as="geometry" /></mxCell><mxCell id="c3" value="&lt;b&gt;PostgreSQL · fuente de verdad&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F3B6F;fontColor=#FFFFFF;strokeColor=#1F3B6F;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="460" height="36" as="geometry" /></mxCell><mxCell id="c4" value="&lt;b&gt;Evento en el outbox (mismo trigger, misma transacción)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B8860B;fontColor=#FFFFFF;strokeColor=#B8860B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="560" y="80" width="460" height="36" as="geometry" /></mxCell><mxCell id="c5" value="&lt;b&gt;Neo4j · proyección&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E6B4F;fontColor=#FFFFFF;strokeColor=#2E6B4F;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1080" y="80" width="560" height="36" as="geometry" /></mxCell><mxCell id="c6" value="&lt;b&gt;social.usuario&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCE8FA;strokeColor=#1F3B6F;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="460" height="44" as="geometry" /></mxCell><mxCell id="c7" value="usuario_creado · usuario_cambio_estado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE7A8;strokeColor=#B8860B;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="560" y="140" width="460" height="44" as="geometry" /></mxCell><mxCell id="c8" value="(:Usuario)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5EA;strokeColor=#2E6B4F;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1080" y="140" width="560" height="44" as="geometry" /></mxCell><mxCell id="c9" style="endArrow=block;endFill=1;html=1;strokeColor=#4A5568;strokeWidth=1.5;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" style="endArrow=block;endFill=1;html=1;strokeColor=#4A5568;strokeWidth=1.5;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;social.seguimiento&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCE8FA;strokeColor=#1F3B6F;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="202" width="460" height="44" as="geometry" /></mxCell><mxCell id="c12" value="seguimiento_creado · seguimiento_borrado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE7A8;strokeColor=#B8860B;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="560" y="202" width="460" height="44" as="geometry" /></mxCell><mxCell id="c13" value="(:Usuario)-[:SIGUE]-&gt;(:Usuario)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5EA;strokeColor=#2E6B4F;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1080" y="202" width="560" height="44" as="geometry" /></mxCell><mxCell id="c14" style="endArrow=block;endFill=1;html=1;strokeColor=#4A5568;strokeWidth=1.5;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" style="endArrow=block;endFill=1;html=1;strokeColor=#4A5568;strokeWidth=1.5;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="&lt;b&gt;social.publicacion&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCE8FA;strokeColor=#1F3B6F;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="264" width="460" height="58" as="geometry" /></mxCell><mxCell id="c17" value="publicacion_creada · publicacion_retirada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE7A8;strokeColor=#B8860B;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="560" y="264" width="460" height="58" as="geometry" /></mxCell><mxCell id="c18" value="(:Usuario)-[:PUBLICO]-&gt;(:Publicacion)&lt;br&gt;(:Publicacion)-[:RESPONDE_A | :COMPARTE]-&gt;(:Publicacion)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5EA;strokeColor=#2E6B4F;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1080" y="264" width="560" height="58" as="geometry" /></mxCell><mxCell id="c19" style="endArrow=block;endFill=1;html=1;strokeColor=#4A5568;strokeWidth=1.5;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" style="endArrow=block;endFill=1;html=1;strokeColor=#4A5568;strokeWidth=1.5;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="&lt;b&gt;social.publicacion_etiqueta&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCE8FA;strokeColor=#1F3B6F;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="460" height="44" as="geometry" /></mxCell><mxCell id="c22" value="publicacion_etiquetada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE7A8;strokeColor=#B8860B;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="560" y="340" width="460" height="44" as="geometry" /></mxCell><mxCell id="c23" value="(:Publicacion)-[:ETIQUETADA_CON]-&gt;(:Etiqueta)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5EA;strokeColor=#2E6B4F;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1080" y="340" width="560" height="44" as="geometry" /></mxCell><mxCell id="c24" style="endArrow=block;endFill=1;html=1;strokeColor=#4A5568;strokeWidth=1.5;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" style="endArrow=block;endFill=1;html=1;strokeColor=#4A5568;strokeWidth=1.5;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="&lt;b&gt;social.mencion_usuario · mencion_figura&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCE8FA;strokeColor=#1F3B6F;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="402" width="460" height="44" as="geometry" /></mxCell><mxCell id="c27" value="publicacion_menciona" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE7A8;strokeColor=#B8860B;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="560" y="402" width="460" height="44" as="geometry" /></mxCell><mxCell id="c28" value="(:Publicacion)-[:MENCIONA]-&gt;(:Usuario | :Figura)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5EA;strokeColor=#2E6B4F;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1080" y="402" width="560" height="44" as="geometry" /></mxCell><mxCell id="c29" style="endArrow=block;endFill=1;html=1;strokeColor=#4A5568;strokeWidth=1.5;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" style="endArrow=block;endFill=1;html=1;strokeColor=#4A5568;strokeWidth=1.5;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="&lt;b&gt;social.reaccion&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCE8FA;strokeColor=#1F3B6F;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="464" width="460" height="44" as="geometry" /></mxCell><mxCell id="c32" value="reaccion_puesta · reaccion_quitada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE7A8;strokeColor=#B8860B;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="560" y="464" width="460" height="44" as="geometry" /></mxCell><mxCell id="c33" value="(:Usuario)-[:REACCIONO {tipo}]-&gt;(:Publicacion)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5EA;strokeColor=#2E6B4F;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1080" y="464" width="560" height="44" as="geometry" /></mxCell><mxCell id="c34" style="endArrow=block;endFill=1;html=1;strokeColor=#4A5568;strokeWidth=1.5;" edge="1" parent="1" source="c31" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" style="endArrow=block;endFill=1;html=1;strokeColor=#4A5568;strokeWidth=1.5;" edge="1" parent="1" source="c32" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="&lt;b&gt;social.figura_publica&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCE8FA;strokeColor=#1F3B6F;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="526" width="460" height="44" as="geometry" /></mxCell><mxCell id="c37" value="figura_creada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE7A8;strokeColor=#B8860B;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="560" y="526" width="460" height="44" as="geometry" /></mxCell><mxCell id="c38" value="(:Figura)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5EA;strokeColor=#2E6B4F;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1080" y="526" width="560" height="44" as="geometry" /></mxCell><mxCell id="c39" style="endArrow=block;endFill=1;html=1;strokeColor=#4A5568;strokeWidth=1.5;" edge="1" parent="1" source="c36" target="c37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" style="endArrow=block;endFill=1;html=1;strokeColor=#4A5568;strokeWidth=1.5;" edge="1" parent="1" source="c37" target="c38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="&lt;b&gt;verificacion.verificacion&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCE8FA;strokeColor=#1F3B6F;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="588" width="460" height="44" as="geometry" /></mxCell><mxCell id="c42" value="verificacion_publicada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE7A8;strokeColor=#B8860B;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="560" y="588" width="460" height="44" as="geometry" /></mxCell><mxCell id="c43" value="(:Publicacion)-[:VERIFICADA_CON {conclusion}]-&gt;(:Serie)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5EA;strokeColor=#2E6B4F;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1080" y="588" width="560" height="44" as="geometry" /></mxCell><mxCell id="c44" style="endArrow=block;endFill=1;html=1;strokeColor=#4A5568;strokeWidth=1.5;" edge="1" parent="1" source="c41" target="c42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c45" style="endArrow=block;endFill=1;html=1;strokeColor=#4A5568;strokeWidth=1.5;" edge="1" parent="1" source="c42" target="c43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c46" value="&lt;b&gt;1. Transacción en PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;CALL social.publicar(…)&lt;br&gt;inserta la publicación &lt;b&gt;y&lt;/b&gt;, por trigger, su evento en &lt;b&gt;social.evento_salida&lt;/b&gt;. Si algo falla, no queda ninguno de los dos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3B6F;strokeWidth=1.5;fontSize=13;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="300" height="130" as="geometry" /></mxCell><mxCell id="c47" value="&lt;b&gt;2. Aviso&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;pg_notify(&#x27;evento_salida&#x27;) despierta al servicio de grafo (si el aviso se pierde, revisa cada 30 s)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3B6F;strokeWidth=1.5;fontSize=13;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="375" y="680" width="300" height="130" as="geometry" /></mxCell><mxCell id="c48" style="endArrow=block;endFill=1;html=1;strokeColor=#1F3B6F;strokeWidth=2;" edge="1" parent="1" source="c46" target="c47"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c49" value="&lt;b&gt;3. Sincronizador&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;eventos_pendientes(&#x27;grafo&#x27;) → aplica el lote en Neo4j con MERGE (idempotente) en una transacción de Neo4j&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3B6F;strokeWidth=1.5;fontSize=13;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="710" y="680" width="300" height="130" as="geometry" /></mxCell><mxCell id="c50" style="endArrow=block;endFill=1;html=1;strokeColor=#1F3B6F;strokeWidth=2;" edge="1" parent="1" source="c47" target="c49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c51" value="&lt;b&gt;4. Confirmación&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;marcar_entregados(&#x27;grafo&#x27;, …) en &lt;b&gt;entrega_evento&lt;/b&gt;. Verificación lee el mismo outbox con su propio consumidor&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3B6F;strokeWidth=1.5;fontSize=13;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="1045" y="680" width="300" height="130" as="geometry" /></mxCell><mxCell id="c52" style="endArrow=block;endFill=1;html=1;strokeColor=#1F3B6F;strokeWidth=2;" edge="1" parent="1" source="c49" target="c51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c53" value="&lt;b&gt;5. Reconstrucción&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;POST /v1/reconstruir: vacía Neo4j y vuelve a aplicar todo el outbox en orden → el mismo grafo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3B6F;strokeWidth=1.5;fontSize=13;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="1380" y="680" width="300" height="130" as="geometry" /></mxCell><mxCell id="c54" style="endArrow=block;endFill=1;html=1;strokeColor=#1F3B6F;strokeWidth=2;" edge="1" parent="1" source="c51" target="c53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c55" value="&lt;b&gt;Por qué así&lt;/b&gt;&lt;br&gt;· PostgreSQL y Neo4j no comparten transacción: el outbox garantiza que ningún cambio se pierda y que ninguno llegue al grafo sin haberse confirmado en PostgreSQL.&lt;br&gt;· Entrega &quot;al menos una vez&quot;: si el servicio se cae entre Neo4j y PostgreSQL, el lote se repite; como todo es MERGE, el grafo queda igual.&lt;br&gt;· El outbox es de solo inserción: es la historia completa de la red, por eso Neo4j se puede reconstruir desde cero." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFF6DD;strokeColor=#C5A56A;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="1640" height="101" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>