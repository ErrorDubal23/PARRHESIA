<mxfile><diagram name="MR ia"><mxGraphModel><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c2" value="&lt;b&gt;MR 4 · Esquema ia&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#1F3B6F;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1200" height="40" as="geometry" /></mxCell><mxCell id="c3" value="credencial" style="swimlane;fontStyle=1;startSize=30;fillColor=#1F3B6F;fontColor=#FFFFFF;strokeColor=#1F3B6F;swimlaneFillColor=#F7F9FC;html=1;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="250" height="162" as="geometry" /></mxCell><mxCell id="c4" value="&lt;u&gt;&lt;b&gt;alias&lt;/b&gt;&lt;/u&gt; &lt;font color=&quot;#666666&quot;&gt;text&lt;/font&gt; &lt;font color=&quot;#B07D00&quot;&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; &lt;font color=&quot;#8F1D2C&quot;&gt;&lt;b&gt;CK&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c3"><mxGeometry x="0" y="30" width="250" height="22" as="geometry" /></mxCell><mxCell id="c5" value="proveedor &lt;font color=&quot;#666666&quot;&gt;text&lt;/font&gt; &lt;font color=&quot;#8F1D2C&quot;&gt;&lt;b&gt;CK&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c3"><mxGeometry x="0" y="52" width="250" height="22" as="geometry" /></mxCell><mxCell id="c6" value="habilitada &lt;font color=&quot;#666666&quot;&gt;boolean&lt;/font&gt; " style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c3"><mxGeometry x="0" y="74" width="250" height="22" as="geometry" /></mxCell><mxCell id="c7" value="pausada_hasta &lt;font color=&quot;#666666&quot;&gt;timestamptz&lt;/font&gt; &lt;font color=&quot;#999999&quot;&gt;NULL&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c3"><mxGeometry x="0" y="96" width="250" height="22" as="geometry" /></mxCell><mxCell id="c8" value="creado_en &lt;font color=&quot;#666666&quot;&gt;timestamptz&lt;/font&gt; " style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c3"><mxGeometry x="0" y="118" width="250" height="22" as="geometry" /></mxCell><mxCell id="c9" value="actualizado_en &lt;font color=&quot;#666666&quot;&gt;timestamptz&lt;/font&gt; " style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c3"><mxGeometry x="0" y="140" width="250" height="22" as="geometry" /></mxCell><mxCell id="c10" value="trabajo" style="swimlane;fontStyle=1;startSize=30;fillColor=#1F3B6F;fontColor=#FFFFFF;strokeColor=#1F3B6F;swimlaneFillColor=#F7F9FC;html=1;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="277" width="257" height="250" as="geometry" /></mxCell><mxCell id="c11" value="&lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt; &lt;font color=&quot;#666666&quot;&gt;uuid&lt;/font&gt; &lt;font color=&quot;#B07D00&quot;&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c10"><mxGeometry x="0" y="30" width="257" height="22" as="geometry" /></mxCell><mxCell id="c12" value="tipo &lt;font color=&quot;#666666&quot;&gt;text&lt;/font&gt; &lt;font color=&quot;#8F1D2C&quot;&gt;&lt;b&gt;CK&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c10"><mxGeometry x="0" y="52" width="257" height="22" as="geometry" /></mxCell><mxCell id="c13" value="version_prompt &lt;font color=&quot;#666666&quot;&gt;text&lt;/font&gt; " style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c10"><mxGeometry x="0" y="74" width="257" height="22" as="geometry" /></mxCell><mxCell id="c14" value="entrada &lt;font color=&quot;#666666&quot;&gt;jsonb&lt;/font&gt; " style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c10"><mxGeometry x="0" y="96" width="257" height="22" as="geometry" /></mxCell><mxCell id="c15" value="huella_entrada &lt;font color=&quot;#666666&quot;&gt;text&lt;/font&gt; " style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c10"><mxGeometry x="0" y="118" width="257" height="22" as="geometry" /></mxCell><mxCell id="c16" value="estado &lt;font color=&quot;#666666&quot;&gt;text&lt;/font&gt; &lt;font color=&quot;#8F1D2C&quot;&gt;&lt;b&gt;CK&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c10"><mxGeometry x="0" y="140" width="257" height="22" as="geometry" /></mxCell><mxCell id="c17" value="salida &lt;font color=&quot;#666666&quot;&gt;jsonb&lt;/font&gt; &lt;font color=&quot;#8F1D2C&quot;&gt;&lt;b&gt;CK&lt;/b&gt;&lt;/font&gt; &lt;font color=&quot;#999999&quot;&gt;NULL&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c10"><mxGeometry x="0" y="162" width="257" height="22" as="geometry" /></mxCell><mxCell id="c18" value="proximo_intento_en &lt;font color=&quot;#666666&quot;&gt;timestamptz&lt;/font&gt; " style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c10"><mxGeometry x="0" y="184" width="257" height="22" as="geometry" /></mxCell><mxCell id="c19" value="creado_en &lt;font color=&quot;#666666&quot;&gt;timestamptz&lt;/font&gt; " style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c10"><mxGeometry x="0" y="206" width="257" height="22" as="geometry" /></mxCell><mxCell id="c20" value="terminado_en &lt;font color=&quot;#666666&quot;&gt;timestamptz&lt;/font&gt; &lt;font color=&quot;#8F1D2C&quot;&gt;&lt;b&gt;CK&lt;/b&gt;&lt;/font&gt; &lt;font color=&quot;#999999&quot;&gt;NULL&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c10"><mxGeometry x="0" y="228" width="257" height="22" as="geometry" /></mxCell><mxCell id="c21" value="intento" style="swimlane;fontStyle=1;startSize=30;fillColor=#1F3B6F;fontColor=#FFFFFF;strokeColor=#1F3B6F;swimlaneFillColor=#F7F9FC;html=1;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="447" y="70" width="250" height="250" as="geometry" /></mxCell><mxCell id="c22" value="&lt;i&gt;&lt;u&gt;&lt;b&gt;trabajo_id&lt;/b&gt;&lt;/u&gt;&lt;/i&gt; &lt;font color=&quot;#666666&quot;&gt;uuid&lt;/font&gt; &lt;font color=&quot;#B07D00&quot;&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; &lt;font color=&quot;#1F5FA8&quot;&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c21"><mxGeometry x="0" y="30" width="250" height="22" as="geometry" /></mxCell><mxCell id="c23" value="&lt;u&gt;&lt;b&gt;numero&lt;/b&gt;&lt;/u&gt; &lt;font color=&quot;#666666&quot;&gt;smallint&lt;/font&gt; &lt;font color=&quot;#B07D00&quot;&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; &lt;font color=&quot;#8F1D2C&quot;&gt;&lt;b&gt;CK&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c21"><mxGeometry x="0" y="52" width="250" height="22" as="geometry" /></mxCell><mxCell id="c24" value="&lt;i&gt;credencial_alias&lt;/i&gt; &lt;font color=&quot;#666666&quot;&gt;text&lt;/font&gt; &lt;font color=&quot;#1F5FA8&quot;&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c21"><mxGeometry x="0" y="74" width="250" height="22" as="geometry" /></mxCell><mxCell id="c25" value="modelo &lt;font color=&quot;#666666&quot;&gt;text&lt;/font&gt; " style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c21"><mxGeometry x="0" y="96" width="250" height="22" as="geometry" /></mxCell><mxCell id="c26" value="resultado &lt;font color=&quot;#666666&quot;&gt;text&lt;/font&gt; &lt;font color=&quot;#8F1D2C&quot;&gt;&lt;b&gt;CK&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c21"><mxGeometry x="0" y="118" width="250" height="22" as="geometry" /></mxCell><mxCell id="c27" value="tokens_entrada &lt;font color=&quot;#666666&quot;&gt;integer&lt;/font&gt; &lt;font color=&quot;#8F1D2C&quot;&gt;&lt;b&gt;CK&lt;/b&gt;&lt;/font&gt; &lt;font color=&quot;#999999&quot;&gt;NULL&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c21"><mxGeometry x="0" y="140" width="250" height="22" as="geometry" /></mxCell><mxCell id="c28" value="tokens_salida &lt;font color=&quot;#666666&quot;&gt;integer&lt;/font&gt; &lt;font color=&quot;#8F1D2C&quot;&gt;&lt;b&gt;CK&lt;/b&gt;&lt;/font&gt; &lt;font color=&quot;#999999&quot;&gt;NULL&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c21"><mxGeometry x="0" y="162" width="250" height="22" as="geometry" /></mxCell><mxCell id="c29" value="error &lt;font color=&quot;#666666&quot;&gt;text&lt;/font&gt; &lt;font color=&quot;#8F1D2C&quot;&gt;&lt;b&gt;CK&lt;/b&gt;&lt;/font&gt; &lt;font color=&quot;#999999&quot;&gt;NULL&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c21"><mxGeometry x="0" y="184" width="250" height="22" as="geometry" /></mxCell><mxCell id="c30" value="iniciado_en &lt;font color=&quot;#666666&quot;&gt;timestamptz&lt;/font&gt; &lt;font color=&quot;#8F1D2C&quot;&gt;&lt;b&gt;CK&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c21"><mxGeometry x="0" y="206" width="250" height="22" as="geometry" /></mxCell><mxCell id="c31" value="terminado_en &lt;font color=&quot;#666666&quot;&gt;timestamptz&lt;/font&gt; &lt;font color=&quot;#8F1D2C&quot;&gt;&lt;b&gt;CK&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c21"><mxGeometry x="0" y="228" width="250" height="22" as="geometry" /></mxCell><mxCell id="c32" style="edgeStyle=entityRelationEdgeStyle;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;strokeColor=#4A5568;strokeWidth=1.3;" edge="1" parent="1" source="c24" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" style="edgeStyle=entityRelationEdgeStyle;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;strokeColor=#4A5568;strokeWidth=1.3;" edge="1" parent="1" source="c22" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="&lt;b&gt;Restricciones CHECK&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;credencial&lt;/b&gt; · credencial_alias_valido: &lt;font color=&quot;#555555&quot;&gt;(alias ~ &amp;#x27;^[a-z0-9_]{3,40}$&amp;#x27;)&lt;/font&gt;&lt;br&gt;&lt;b&gt;credencial&lt;/b&gt; · credencial_proveedor_valido: &lt;font color=&quot;#555555&quot;&gt;(proveedor ~ &amp;#x27;^[a-z0-9_]{2,30}$&amp;#x27;)&lt;/font&gt;&lt;br&gt;&lt;b&gt;intento&lt;/b&gt; · intento_error_si_falla: &lt;font color=&quot;#555555&quot;&gt;(resultado = &amp;#x27;ok&amp;#x27;) = (error IS NULL)&lt;/font&gt;&lt;br&gt;&lt;b&gt;intento&lt;/b&gt; · intento_fechas_validas: &lt;font color=&quot;#555555&quot;&gt;(terminado_en &amp;gt;= iniciado_en)&lt;/font&gt;&lt;br&gt;&lt;b&gt;intento&lt;/b&gt; · intento_numero_positivo: &lt;font color=&quot;#555555&quot;&gt;(numero &amp;gt;= 1)&lt;/font&gt;&lt;br&gt;&lt;b&gt;intento&lt;/b&gt; · intento_resultado_valido: &lt;font color=&quot;#555555&quot;&gt;(resultado IN (&amp;#x27;ok&amp;#x27;, &amp;#x27;limite_alcanzado&amp;#x27;, &amp;#x27;error_proveedor&amp;#x27;, &amp;#x27;salida_invalida&amp;#x27;))&lt;/font&gt;&lt;br&gt;&lt;b&gt;intento&lt;/b&gt; · intento_tokens_positivos: &lt;font color=&quot;#555555&quot;&gt;(COALESCE(tokens_entrada, 0) &amp;gt;= 0) AND (COALESCE(tokens_salida, 0) &amp;gt;= 0)&lt;/font&gt;&lt;br&gt;&lt;b&gt;trabajo&lt;/b&gt; · trabajo_estado_valido: &lt;font color=&quot;#555555&quot;&gt;(estado IN (&amp;#x27;en_cola&amp;#x27;, &amp;#x27;en_curso&amp;#x27;, &amp;#x27;terminado&amp;#x27;, &amp;#x27;fallido&amp;#x27;))&lt;/font&gt;&lt;br&gt;&lt;b&gt;trabajo&lt;/b&gt; · trabajo_fin_solo_si_cerrado: &lt;font color=&quot;#555555&quot;&gt;(estado IN (&amp;#x27;terminado&amp;#x27;, &amp;#x27;fallido&amp;#x27;)) = (terminado_en IS NOT NULL)&lt;/font&gt;&lt;br&gt;&lt;b&gt;trabajo&lt;/b&gt; · trabajo_salida_solo_si_terminado: &lt;font color=&quot;#555555&quot;&gt;(estado = &amp;#x27;terminado&amp;#x27;) = (salida IS NOT NULL)&lt;/font&gt;&lt;br&gt;&lt;b&gt;trabajo&lt;/b&gt; · trabajo_tipo_valido: &lt;font color=&quot;#555555&quot;&gt;(tipo IN (&amp;#x27;extraer_afirmaciones&amp;#x27;, &amp;#x27;redactar_explicacion&amp;#x27;, &amp;#x27;agrupar_temas&amp;#x27;, &amp;#x27;extraer_declaraciones&amp;#x27;))&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFFFFF;strokeColor=#BBBBBB;" vertex="1" parent="1"><mxGeometry x="40" y="592" width="1100" height="221" as="geometry" /></mxCell><mxCell id="c35" value="&lt;b&gt;Reglas que el diagrama no muestra por sí solo&lt;/b&gt;&lt;br&gt;· credencial no tiene columna para la llave secreta: la llave vive en la configuración del servicio de IA, con el mismo alias.&lt;br&gt;· Índices únicos parciales en trabajo (tipo, version_prompt, huella_entrada): uno WHERE estado = &amp;#x27;terminado&amp;#x27; (caché) y otro WHERE estado IN (&amp;#x27;en_cola&amp;#x27;, &amp;#x27;en_curso&amp;#x27;).&lt;br&gt;· huella_entrada la calcula un trigger; tipo, versión y entrada no cambian; máquina de estados en_cola → en_curso → terminado / fallido. intento: solo inserción.&lt;br&gt;· tomar_trabajo usa FOR UPDATE SKIP LOCKED con un plazo de 5 minutos; registrar_intento pausa la cuenta ante un límite y reintenta con espera creciente." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFF6DD;strokeColor=#C5A56A;" vertex="1" parent="1"><mxGeometry x="1180" y="592" width="760" height="176" as="geometry" /></mxCell><mxCell id="c36" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B07D00&quot;&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; llave primaria · &lt;font color=&quot;#1F5FA8&quot;&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; llave foránea · &lt;font color=&quot;#2E6B4F&quot;&gt;&lt;b&gt;UQ&lt;/b&gt;&lt;/font&gt; único · &lt;font color=&quot;#8F1D2C&quot;&gt;&lt;b&gt;CK&lt;/b&gt;&lt;/font&gt; CHECK · &lt;font color=&quot;#999999&quot;&gt;NULL&lt;/font&gt; admite vacío&lt;br&gt;&lt;font color=&quot;#1F5FA8&quot;&gt;→ esquema.tabla&lt;/font&gt;: referencia a otro esquema, revisada por un trigger (no es llave foránea)&lt;br&gt;Línea: pata de gallo en la tabla hija; O = opcional, | = obligatorio. Todas las tablas son de PostgreSQL 17." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFFFFF;strokeColor=#BBBBBB;" vertex="1" parent="1"><mxGeometry x="1180" y="797" width="760" height="86" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>