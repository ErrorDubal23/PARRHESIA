dge="1" parent="1" source="c15" target="c242"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c244" value="&lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EAF5EA;strokeColor=#3C8A3C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2468" y="1905" width="96" height="30" as="geometry" /></mxCell><mxCell id="c245" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="c16" target="c244"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c246" value="codigo" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EAF5EA;strokeColor=#3C8A3C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2401" y="2003" width="96" height="30" as="geometry" /></mxCell><mxCell id="c247" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="c16" target="c246"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c248" value="nombre" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EAF5EA;strokeColor=#3C8A3C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2272" y="2043" width="96" height="30" as="geometry" /></mxCell><mxCell id="c249" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="c16" target="c248"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c250" value="explicacion" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EAF5EA;strokeColor=#3C8A3C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2072" y="1905" width="105" height="30" as="geometry" /></mxCell><mxCell id="c251" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="c16" target="c250"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c252" value="prueba" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EAF5EA;strokeColor=#3C8A3C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2272" y="1767" width="96" height="30" as="geometry" /></mxCell><mxCell id="c253" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="c16" target="c252"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c254" value="&lt;b&gt;Reglas que el diagrama no muestra por sí solo&lt;/b&gt;&lt;br&gt;· Observaciones, descargas, archivos, contrastes, aprobaciones y eventos de alerta son de solo inserción: una versión nueva es una fila nueva.&lt;br&gt;· El valor vigente de un periodo es la observación de mayor secuencia; si está en cuarentena, el periodo no tiene valor (nunca se usa uno anterior).&lt;br&gt;· Una alerta solo cambia de estado (abierta ↔ cerrada) y cada cambio deja su evento con quién y por qué (trigger diferido).&lt;br&gt;· Una sola alerta abierta por serie, periodo, territorio, tipo y valor. La alerta también guarda su serie (relación omitida en el dibujo).&lt;br&gt;· Fuente, indicador, serie, notas y diferencias son copia de git (fichas aprobadas con su huella); los códigos del catálogo no se traducen.&lt;br&gt;· Los valores son numeric sin escala: decimal exacto, nunca float. Archivo de evidencia y brecha de contexto no se relacionan con otras entidades." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFF6DD;strokeColor=#C5A56A;" vertex="1" parent="1"><mxGeometry x="40" y="2250" width="900" height="236" as="geometry" /></mxCell><mxCell id="c255" value="&lt;b&gt;Notación de Chen&lt;/b&gt;&lt;br&gt;Rectángulo: entidad · Rombo: relación · Elipse: atributo&lt;br&gt;&lt;u&gt;Subrayado&lt;/u&gt;: identificador · Elipse punteada: atributo derivado (lo calcula la base) · Doble elipse: atributo multivaluado&lt;br&gt;Doble rectángulo: entidad débil · Doble rombo: relación que la identifica · Subrayado punteado: clave parcial&lt;br&gt;Borde punteado: entidad detallada en otro MER&lt;br&gt;(mín,máx) junto a una entidad: en cuántas relaciones de ese tipo participa cada ejemplar de esa entidad" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFFFFF;strokeColor=#BBBBBB;" vertex="1" parent="1"><mxGeometry x="980" y="2250" width="760" height="131" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>