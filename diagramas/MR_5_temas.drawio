" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c44"><mxGeometry x="0" y="118" width="355" height="22" as="geometry" /></mxCell><mxCell id="c50" value="&lt;i&gt;trabajo_ia_id&lt;/i&gt; &lt;font color=&quot;#666666&quot;&gt;uuid&lt;/font&gt; &lt;font color=&quot;#999999&quot;&gt;NULL&lt;/font&gt; &lt;font color=&quot;#1F5FA8&quot;&gt;→ ia.trabajo&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c44"><mxGeometry x="0" y="140" width="355" height="22" as="geometry" /></mxCell><mxCell id="c51" value="creado_en &lt;font color=&quot;#666666&quot;&gt;timestamptz&lt;/font&gt; " style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c44"><mxGeometry x="0" y="162" width="355" height="22" as="geometry" /></mxCell><mxCell id="c52" value="tema_articulo" style="swimlane;fontStyle=1;startSize=30;fillColor=#1F3B6F;fontColor=#FFFFFF;strokeColor=#1F3B6F;swimlaneFillColor=#F7F9FC;html=1;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="896" y="299" width="250" height="74" as="geometry" /></mxCell><mxCell id="c53" value="&lt;i&gt;&lt;u&gt;&lt;b&gt;tema_id&lt;/b&gt;&lt;/u&gt;&lt;/i&gt; &lt;font color=&quot;#666666&quot;&gt;uuid&lt;/font&gt; &lt;font color=&quot;#B07D00&quot;&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; &lt;font color=&quot;#1F5FA8&quot;&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c52"><mxGeometry x="0" y="30" width="250" height="22" as="geometry" /></mxCell><mxCell id="c54" value="&lt;i&gt;&lt;u&gt;&lt;b&gt;articulo_id&lt;/b&gt;&lt;/u&gt;&lt;/i&gt; &lt;font color=&quot;#666666&quot;&gt;uuid&lt;/font&gt; &lt;font color=&quot;#B07D00&quot;&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; &lt;font color=&quot;#1F5FA8&quot;&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c52"><mxGeometry x="0" y="52" width="250" height="22" as="geometry" /></mxCell><mxCell id="c55" style="edgeStyle=entityRelationEdgeStyle;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;strokeColor=#4A5568;strokeWidth=1.3;" edge="1" parent="1" source="c32" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c56" style="edgeStyle=entityRelationEdgeStyle;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;strokeColor=#4A5568;strokeWidth=1.3;" edge="1" parent="1" source="c46" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c57" style="edgeStyle=entityRelationEdgeStyle;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;strokeColor=#4A5568;strokeWidth=1.3;" edge="1" parent="1" source="c41" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c58" style="edgeStyle=entityRelationEdgeStyle;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;strokeColor=#4A5568;strokeWidth=1.3;" edge="1" parent="1" source="c54" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c59" style="edgeStyle=entityRelationEdgeStyle;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;strokeColor=#4A5568;strokeWidth=1.3;" edge="1" parent="1" source="c53" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c60" value="&lt;b&gt;Restricciones CHECK&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;articulo&lt;/b&gt; · articulo_titulo_valido: &lt;font color=&quot;#555555&quot;&gt;(length(TRIM(BOTH FROM titulo)) &amp;gt;= 1)&lt;/font&gt;&lt;br&gt;&lt;b&gt;articulo&lt;/b&gt; · articulo_url_valida: &lt;font color=&quot;#555555&quot;&gt;(url ~ &amp;#x27;^https?://&amp;#x27;)&lt;/font&gt;&lt;br&gt;&lt;b&gt;declaracion_reportada&lt;/b&gt; · declaracion_reportada_actor_valido: &lt;font color=&quot;#555555&quot;&gt;(length(TRIM(BOTH FROM actor)) &amp;gt;= 2) AND (length(TRIM(BOTH FROM actor)) &amp;lt;= 120)&lt;/font&gt;&lt;br&gt;&lt;b&gt;declaracion_reportada&lt;/b&gt; · declaracion_reportada_cita_valida: &lt;font color=&quot;#555555&quot;&gt;(length(TRIM(BOTH FROM texto_citado)) &amp;gt;= 5) AND (length(TRIM(BOTH FROM texto_citado)) &amp;lt;= 1000)&lt;/font&gt;&lt;br&gt;&lt;b&gt;declaracion_reportada&lt;/b&gt; · declaracion_reportada_con_cifras: &lt;font color=&quot;#555555&quot;&gt;(cardinality(util.cifras_en_texto(texto_citado)) &amp;gt; 0)&lt;/font&gt;&lt;br&gt;&lt;b&gt;entrega_evento&lt;/b&gt; · entrega_evento_consumidor_valido: &lt;font color=&quot;#555555&quot;&gt;(consumidor IN (&amp;#x27;grafo&amp;#x27;, &amp;#x27;verificacion&amp;#x27;))&lt;/font&gt;&lt;br&gt;&lt;b&gt;medio&lt;/b&gt; · medio_canal_valido: &lt;font color=&quot;#555555&quot;&gt;(canal IN (&amp;#x27;rss&amp;#x27;, &amp;#x27;gdelt&amp;#x27;))&lt;/font&gt;&lt;br&gt;&lt;b&gt;medio&lt;/b&gt; · medio_urls_validas: &lt;font color=&quot;#555555&quot;&gt;(url_sitio ~ &amp;#x27;^https?://&amp;#x27;) AND (url_canal ~ &amp;#x27;^https?://&amp;#x27;)&lt;/font&gt;&lt;br&gt;&lt;b&gt;tema&lt;/b&gt; · tema_etiqueta_valida: &lt;font color=&quot;#555555&quot;&gt;(etiqueta ~ &amp;#x27;^[a-z_áéíóúñü]{2,50}$&amp;#x27;)&lt;/font&gt;&lt;br&gt;&lt;b&gt;tema&lt;/b&gt; · tema_minimo_tres_medios: &lt;font color=&quot;#555555&quot;&gt;(total_medios &amp;gt;= 3)&lt;/font&gt;&lt;br&gt;&lt;b&gt;tema&lt;/b&gt; · tema_posicion_valida: &lt;font color=&quot;#555555&quot;&gt;(posicion &amp;gt;= 1) AND (posicion &amp;lt;= 7)&lt;/font&gt;&lt;br&gt;&lt;b&gt;tema&lt;/b&gt; · tema_titulo_sin_cifras: &lt;font color=&quot;#555555&quot;&gt;(titulo !~ &amp;#x27;[0-9]&amp;#x27;) AND ((length(TRIM(BOTH FROM titulo)) &amp;gt;= 3) AND (length(TRIM(BOTH FROM titulo)) &amp;lt;= 120))&lt;/font&gt;&lt;br&gt;&lt;b&gt;tema&lt;/b&gt; · tema_totales_coherentes: &lt;font color=&quot;#555555&quot;&gt;(total_articulos &amp;gt;= total_medios)&lt;/font&gt;&lt;br&gt;&lt;b&gt;tema&lt;/b&gt; · tema_ventana_valida: &lt;font color=&quot;#555555&quot;&gt;(ventana_fin &amp;gt; ventana_inicio)&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFFFFF;strokeColor=#BBBBBB;" vertex="1" parent="1"><mxGeometry x="40" y="843" width="1100" height="266" as="geometry" /></mxCell><mxCell id="c61" value="&lt;b&gt;Reglas que el diagrama no muestra por sí solo&lt;/b&gt;&lt;br&gt;· declaracion_reportada_validar: la cita debe aparecer textual en el artículo; la figura, si se da, debe existir en social.&lt;br&gt;· registrar_temas: la base cuenta los medios distintos, descarta los grupos de menos de 3, ordena y guarda 7 como máximo (todo o nada).&lt;br&gt;· articulo, tema, tema_articulo, declaracion_reportada, evento_salida y entrega_evento: solo inserción. huella la calcula un trigger.&lt;br&gt;· Procedimientos: configurar_medio, registrar_articulos, registrar_temas, registrar_declaraciones, marcar_entregados." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFF6DD;strokeColor=#C5A56A;" vertex="1" parent="1"><mxGeometry x="1180" y="843" width="760" height="176" as="geometry" /></mxCell><mxCell id="c62" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B07D00&quot;&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; llave primaria · &lt;font color=&quot;#1F5FA8&quot;&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; llave foránea · &lt;font color=&quot;#2E6B4F&quot;&gt;&lt;b&gt;UQ&lt;/b&gt;&lt;/font&gt; único · &lt;font color=&quot;#8F1D2C&quot;&gt;&lt;b&gt;CK&lt;/b&gt;&lt;/font&gt; CHECK · &lt;font color=&quot;#999999&quot;&gt;NULL&lt;/font&gt; admite vacío&lt;br&gt;&lt;font color=&quot;#1F5FA8&quot;&gt;→ esquema.tabla&lt;/font&gt;: referencia a otro esquema, revisada por un trigger (no es llave foránea)&lt;br&gt;Línea: pata de gallo en la tabla hija; O = opcional, | = obligatorio. Todas las tablas son de PostgreSQL 17." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFFFFF;strokeColor=#BBBBBB;" vertex="1" parent="1"><mxGeometry x="1180" y="1048" width="760" height="86" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>