ont color=&quot;#555555&quot;&gt;(nombre ~ &amp;#x27;^[a-z0-9_áéíóúñü]{1,50}$&amp;#x27;)&lt;/font&gt;&lt;br&gt;&lt;b&gt;publicacion&lt;/b&gt; · publicacion_estado_valido: &lt;font color=&quot;#555555&quot;&gt;(estado IN (&amp;#x27;visible&amp;#x27;, &amp;#x27;retirada_por_autor&amp;#x27;, &amp;#x27;retirada_por_moderacion&amp;#x27;))&lt;/font&gt;&lt;br&gt;&lt;b&gt;publicacion&lt;/b&gt; · publicacion_no_a_si_misma: &lt;font color=&quot;#555555&quot;&gt;(responde_a_id &amp;lt;&amp;gt; id) AND (comparte_id &amp;lt;&amp;gt; id)&lt;/font&gt;&lt;br&gt;&lt;b&gt;publicacion&lt;/b&gt; · publicacion_texto_o_compartida: &lt;font color=&quot;#555555&quot;&gt;(texto IS NOT NULL) OR (comparte_id IS NOT NULL)&lt;/font&gt;&lt;br&gt;&lt;b&gt;publicacion&lt;/b&gt; · publicacion_texto_valido: &lt;font color=&quot;#555555&quot;&gt;(length(TRIM(BOTH FROM texto)) &amp;gt;= 1) AND (length(TRIM(BOTH FROM texto)) &amp;lt;= 500)&lt;/font&gt;&lt;br&gt;&lt;b&gt;publicacion&lt;/b&gt; · publicacion_totales_positivos: &lt;font color=&quot;#555555&quot;&gt;(total_respuestas &amp;gt;= 0) AND (total_compartidas &amp;gt;= 0) AND (total_reacciones &amp;gt;= 0)&lt;/font&gt;&lt;br&gt;&lt;b&gt;publicacion&lt;/b&gt; · publicacion_un_solo_origen: &lt;font color=&quot;#555555&quot;&gt;(num_nonnulls(responde_a_id, comparte_id) &amp;lt;= 1)&lt;/font&gt;&lt;br&gt;&lt;b&gt;reaccion&lt;/b&gt; · reaccion_tipo_valido: &lt;font color=&quot;#555555&quot;&gt;(tipo IN (&amp;#x27;me_gusta&amp;#x27;, &amp;#x27;util&amp;#x27;))&lt;/font&gt;&lt;br&gt;&lt;b&gt;seguimiento&lt;/b&gt; · seguimiento_no_a_si_mismo: &lt;font color=&quot;#555555&quot;&gt;(seguidor_id &amp;lt;&amp;gt; seguido_id)&lt;/font&gt;&lt;br&gt;&lt;b&gt;tendencia&lt;/b&gt; · tendencia_diversidad_valida: &lt;font color=&quot;#555555&quot;&gt;(diversidad &amp;gt;= (0)) AND (diversidad &amp;lt;= (1))&lt;/font&gt;&lt;br&gt;&lt;b&gt;tendencia&lt;/b&gt; · tendencia_minimo_tres_autores: &lt;font color=&quot;#555555&quot;&gt;(total_autores &amp;gt;= 3)&lt;/font&gt;&lt;br&gt;&lt;b&gt;tendencia&lt;/b&gt; · tendencia_posicion_valida: &lt;font color=&quot;#555555&quot;&gt;(posicion &amp;gt;= 1)&lt;/font&gt;&lt;br&gt;&lt;b&gt;tendencia&lt;/b&gt; · tendencia_ventana_valida: &lt;font color=&quot;#555555&quot;&gt;(ventana_fin &amp;gt; ventana_inicio)&lt;/font&gt;&lt;br&gt;&lt;b&gt;usuario&lt;/b&gt; · usuario_biografia_valida: &lt;font color=&quot;#555555&quot;&gt;(length(biografia) &amp;lt;= 280)&lt;/font&gt;&lt;br&gt;&lt;b&gt;usuario&lt;/b&gt; · usuario_clave_es_hash: &lt;font color=&quot;#555555&quot;&gt;(clave_hash ~ &amp;#x27;^\$(2[aby]\$|argon2id\$)&amp;#x27;)&lt;/font&gt;&lt;br&gt;&lt;b&gt;usuario&lt;/b&gt; · usuario_correo_valido: &lt;font color=&quot;#555555&quot;&gt;(correo ~ &amp;#x27;^[^@\s]+@[^@\s]+\.[^@\s]+$&amp;#x27;)&lt;/font&gt;&lt;br&gt;&lt;b&gt;usuario&lt;/b&gt; · usuario_estado_valido: &lt;font color=&quot;#555555&quot;&gt;(estado IN (&amp;#x27;activo&amp;#x27;, &amp;#x27;en_revision&amp;#x27;, &amp;#x27;suspendido&amp;#x27;))&lt;/font&gt;&lt;br&gt;&lt;b&gt;usuario&lt;/b&gt; · usuario_nombre_usuario_valido: &lt;font color=&quot;#555555&quot;&gt;(nombre_usuario ~ &amp;#x27;^[a-z0-9_]{3,30}$&amp;#x27;)&lt;/font&gt;&lt;br&gt;&lt;b&gt;usuario&lt;/b&gt; · usuario_nombre_visible_valido: &lt;font color=&quot;#555555&quot;&gt;(length(TRIM(BOTH FROM nombre_visible)) &amp;gt;= 1) AND (length(TRIM(BOTH FROM nombre_visible)) &amp;lt;= 60)&lt;/font&gt;&lt;br&gt;&lt;b&gt;usuario&lt;/b&gt; · usuario_rol_valido: &lt;font color=&quot;#555555&quot;&gt;(rol IN (&amp;#x27;usuario&amp;#x27;, &amp;#x27;verificador&amp;#x27;, &amp;#x27;admin&amp;#x27;))&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFFFFF;strokeColor=#BBBBBB;" vertex="1" parent="1"><mxGeometry x="40" y="1257" width="1100" height="446" as="geometry" /></mxCell><mxCell id="c111" value="&lt;b&gt;Reglas que el diagrama no muestra por sí solo&lt;/b&gt;&lt;br&gt;· Contadores de publicacion mantenidos por triggers (publicacion_contadores, reaccion_contadores); el texto no se edita y una retirada no vuelve a visible.&lt;br&gt;· Outbox: cada cambio escribe su evento en evento_salida en la misma transacción; entrega_evento registra qué consumidor (grafo, verificación) lo procesó.&lt;br&gt;· declaracion: solo cambia estado_promesa. tendencia, evento_salida y entrega_evento: solo inserción.&lt;br&gt;· Procedimientos: registrar_usuario, publicar, retirar_publicacion, seguir, dejar_de_seguir, reaccionar, quitar_reaccion, registrar_declaracion, registrar_tendencias, marcar_entregados." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFF6DD;strokeColor=#C5A56A;" vertex="1" parent="1"><mxGeometry x="1180" y="1257" width="760" height="161" as="geometry" /></mxCell><mxCell id="c112" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B07D00&quot;&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; llave primaria · &lt;font color=&quot;#1F5FA8&quot;&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; llave foránea · &lt;font color=&quot;#2E6B4F&quot;&gt;&lt;b&gt;UQ&lt;/b&gt;&lt;/font&gt; único · &lt;font color=&quot;#8F1D2C&quot;&gt;&lt;b&gt;CK&lt;/b&gt;&lt;/font&gt; CHECK · &lt;font color=&quot;#999999&quot;&gt;NULL&lt;/font&gt; admite vacío&lt;br&gt;&lt;font color=&quot;#1F5FA8&quot;&gt;→ esquema.tabla&lt;/font&gt;: referencia a otro esquema, revisada por un trigger (no es llave foránea)&lt;br&gt;Línea: pata de gallo en la tabla hija; O = opcional, | = obligatorio. Todas las tablas son de PostgreSQL 17." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFFFFF;strokeColor=#BBBBBB;" vertex="1" parent="1"><mxGeometry x="1180" y="1447" width="760" height="86" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>