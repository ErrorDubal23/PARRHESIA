okeColor=#4A5568;strokeWidth=1.3;" edge="1" parent="1" source="c42" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c72" style="edgeStyle=entityRelationEdgeStyle;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;strokeColor=#4A5568;strokeWidth=1.3;" edge="1" parent="1" source="c56" target="c46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c73" style="edgeStyle=entityRelationEdgeStyle;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;strokeColor=#4A5568;strokeWidth=1.3;" edge="1" parent="1" source="c68" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c74" style="edgeStyle=entityRelationEdgeStyle;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;strokeColor=#4A5568;strokeWidth=1.3;" edge="1" parent="1" source="c67" target="c46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c75" style="edgeStyle=entityRelationEdgeStyle;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;strokeColor=#4A5568;strokeWidth=1.3;" edge="1" parent="1" source="c61" target="c46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c76" style="edgeStyle=entityRelationEdgeStyle;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;strokeColor=#4A5568;strokeWidth=1.3;" edge="1" parent="1" source="c47" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c77" value="&lt;b&gt;Restricciones CHECK&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;afirmacion&lt;/b&gt; · afirmacion_comparacion_valida: &lt;font color=&quot;#555555&quot;&gt;(comparacion IN (&amp;#x27;nivel&amp;#x27;, &amp;#x27;variacion_porcentual&amp;#x27;, &amp;#x27;variacion_puntos&amp;#x27;))&lt;/font&gt;&lt;br&gt;&lt;b&gt;afirmacion&lt;/b&gt; · afirmacion_confianza_valida: &lt;font color=&quot;#555555&quot;&gt;(confianza_extraccion &amp;gt;= (0)) AND (confianza_extraccion &amp;lt;= (1))&lt;/font&gt;&lt;br&gt;&lt;b&gt;afirmacion&lt;/b&gt; · afirmacion_estado_valido: &lt;font color=&quot;#555555&quot;&gt;(estado IN (&amp;#x27;extraida&amp;#x27;, &amp;#x27;no_verificable&amp;#x27;, &amp;#x27;verificada&amp;#x27;, &amp;#x27;requiere_revision&amp;#x27;))&lt;/font&gt;&lt;br&gt;&lt;b&gt;afirmacion&lt;/b&gt; · afirmacion_indicador_valido: &lt;font color=&quot;#555555&quot;&gt;(codigo_indicador IN (&amp;#x27;inflation&amp;#x27;, &amp;#x27;unemployment&amp;#x27;, &amp;#x27;minimum_wage&amp;#x27;, &amp;#x27;public_debt&amp;#x27;, &amp;#x27;homicides&amp;#x27;, &amp;#x27;theft&amp;#x27;, &amp;#x27;extortion&amp;#x27;, &amp;#x27;kidnapping&amp;#x27;))&lt;/font&gt;&lt;br&gt;&lt;b&gt;afirmacion&lt;/b&gt; · afirmacion_periodos_validos: &lt;font color=&quot;#555555&quot;&gt;(periodo_desde ~ &amp;#x27;^\d{4}(-\d{2}(-\d{2})?)?$&amp;#x27;) AND (periodo_hasta ~ &amp;#x27;^\d{4}(-\d{2}(-\d{2})?)?$&amp;#x27;) AND (periodo_desde &amp;lt;= periodo_hasta)&lt;/font&gt;&lt;br&gt;&lt;b&gt;afirmacion&lt;/b&gt; · afirmacion_posicion_valida: &lt;font color=&quot;#555555&quot;&gt;(posicion &amp;gt;= 1)&lt;/font&gt;&lt;br&gt;&lt;b&gt;afirmacion&lt;/b&gt; · afirmacion_un_solo_origen: &lt;font color=&quot;#555555&quot;&gt;(num_nonnulls(publicacion_id, declaracion_id, declaracion_reportada_id) = 1)&lt;/font&gt;&lt;br&gt;&lt;b&gt;afirmacion&lt;/b&gt; · afirmacion_variante_valida: &lt;font color=&quot;#555555&quot;&gt;(variante IN (&amp;#x27;anual&amp;#x27;, &amp;#x27;mensual&amp;#x27;, &amp;#x27;anio_corrido&amp;#x27;, &amp;#x27;tasa&amp;#x27;, &amp;#x27;conteo&amp;#x27;, &amp;#x27;nominal&amp;#x27;, &amp;#x27;real&amp;#x27;))&lt;/font&gt;&lt;br&gt;&lt;b&gt;entrega_evento&lt;/b&gt; · entrega_evento_consumidor_valido: &lt;font color=&quot;#555555&quot;&gt;(consumidor IN (&amp;#x27;grafo&amp;#x27;, &amp;#x27;verificacion&amp;#x27;))&lt;/font&gt;&lt;br&gt;&lt;b&gt;evidencia&lt;/b&gt; · evidencia_rol_valido: &lt;font color=&quot;#555555&quot;&gt;(rol IN (&amp;#x27;citada&amp;#x27;, &amp;#x27;completa&amp;#x27;, &amp;#x27;contraste&amp;#x27;))&lt;/font&gt;&lt;br&gt;&lt;b&gt;palabra_clave&lt;/b&gt; · palabra_clave_indicador_valido: &lt;font color=&quot;#555555&quot;&gt;(codigo_indicador IN (&amp;#x27;inflation&amp;#x27;, &amp;#x27;unemployment&amp;#x27;, &amp;#x27;minimum_wage&amp;#x27;, &amp;#x27;public_debt&amp;#x27;, &amp;#x27;homicides&amp;#x27;, &amp;#x27;theft&amp;#x27;, &amp;#x27;extortion&amp;#x27;, &amp;#x27;kidnapping&amp;#x27;))&lt;/font&gt;&lt;br&gt;&lt;b&gt;palabra_clave&lt;/b&gt; · palabra_clave_minusculas: &lt;font color=&quot;#555555&quot;&gt;(palabra = lower(palabra)) AND (length(palabra) &amp;gt;= 3)&lt;/font&gt;&lt;br&gt;&lt;b&gt;procesamiento&lt;/b&gt; · procesamiento_origen_valido: &lt;font color=&quot;#555555&quot;&gt;(origen_tipo IN (&amp;#x27;publicacion&amp;#x27;, &amp;#x27;declaracion&amp;#x27;, &amp;#x27;declaracion_reportada&amp;#x27;))&lt;/font&gt;&lt;br&gt;&lt;b&gt;procesamiento&lt;/b&gt; · procesamiento_resultado_valido: &lt;font color=&quot;#555555&quot;&gt;(resultado IN (&amp;#x27;sin_cifras&amp;#x27;, &amp;#x27;sin_afirmaciones&amp;#x27;, &amp;#x27;con_afirmaciones&amp;#x27;, &amp;#x27;fallido&amp;#x27;))&lt;/font&gt;&lt;br&gt;&lt;b&gt;prueba_robustez&lt;/b&gt; · prueba_robustez_codigo_valido: &lt;font color=&quot;#555555&quot;&gt;(codigo ~ &amp;#x27;^[a-z_]{3,40}$&amp;#x27;)&lt;/font&gt;&lt;br&gt;&lt;b&gt;resultado_prueba&lt;/b&gt; · resultado_prueba_resultado_valido: &lt;font color=&quot;#555555&quot;&gt;(resultado IN (&amp;#x27;sin_brecha&amp;#x27;, &amp;#x27;con_brecha&amp;#x27;, &amp;#x27;no_aplica&amp;#x27;))&lt;/font&gt;&lt;br&gt;&lt;b&gt;revision_humana&lt;/b&gt; · revision_humana_decision_valida: &lt;font color=&quot;#555555&quot;&gt;(decision IN (&amp;#x27;confirmada&amp;#x27;, &amp;#x27;corregida&amp;#x27;))&lt;/font&gt;&lt;br&gt;&lt;b&gt;revision_humana&lt;/b&gt; · revision_humana_motivo_valido: &lt;font color=&quot;#555555&quot;&gt;(length(TRIM(BOTH FROM motivo)) &amp;gt;= 3)&lt;/font&gt;&lt;br&gt;&lt;b&gt;verificacion&lt;/b&gt; · verificacion_conclusion_valida: &lt;font color=&quot;#555555&quot;&gt;(conclusion IN (&amp;#x27;se_sostiene&amp;#x27;, &amp;#x27;se_debilita&amp;#x27;, &amp;#x27;se_invierte&amp;#x27;, &amp;#x27;sin_dato_comparable&amp;#x27;))&lt;/font&gt;&lt;br&gt;&lt;b&gt;verificacion&lt;/b&gt; · verificacion_explicacion_valida: &lt;font color=&quot;#555555&quot;&gt;(length(TRIM(BOTH FROM explicacion)) &amp;gt;= 1)&lt;/font&gt;&lt;br&gt;&lt;b&gt;verificacion&lt;/b&gt; · verificacion_serie_si_hay_dato: &lt;font color=&quot;#555555&quot;&gt;(codigo_serie IS NULL) = (conclusion = &amp;#x27;sin_dato_comparable&amp;#x27;)&lt;/font&gt;&lt;br&gt;&lt;b&gt;verificacion&lt;/b&gt; · verificacion_version_positiva: &lt;font color=&quot;#555555&quot;&gt;(version &amp;gt;= 1)&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFFFFF;strokeColor=#BBBBBB;" vertex="1" parent="1"><mxGeometry x="40" y="1191" width="1100" height="431" as="geometry" /></mxCell><mxCell id="c78" value="&lt;b&gt;Reglas que el diagrama no muestra por sí solo&lt;/b&gt;&lt;br&gt;· Las columnas con → apuntan a otros esquemas: las revisa un trigger (afirmacion_destino_existe, evidencia_observacion_aceptada, verificacion_serie_existe, revision_por_verificador).&lt;br&gt;· Triggers diferidos al confirmar: verificacion_tiene_evidencia y explicacion_cifras_respaldadas (ninguna cifra fuera de la evidencia).&lt;br&gt;· verificacion, evidencia, resultado_prueba y revision_humana: solo inserción. afirmacion: solo cambia estado (máquina de estados).&lt;br&gt;· Procedimientos: registrar_afirmaciones, registrar_procesamiento, registrar_verificacion, registrar_revision, marcar_entregados." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFF6DD;strokeColor=#C5A56A;" vertex="1" parent="1"><mxGeometry x="1180" y="1191" width="760" height="176" as="geometry" /></mxCell><mxCell id="c79" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B07D00&quot;&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; llave primaria · &lt;font color=&quot;#1F5FA8&quot;&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; llave foránea · &lt;font color=&quot;#2E6B4F&quot;&gt;&lt;b&gt;UQ&lt;/b&gt;&lt;/font&gt; único · &lt;font color=&quot;#8F1D2C&quot;&gt;&lt;b&gt;CK&lt;/b&gt;&lt;/font&gt; CHECK · &lt;font color=&quot;#999999&quot;&gt;NULL&lt;/font&gt; admite vacío&lt;br&gt;&lt;font color=&quot;#1F5FA8&quot;&gt;→ esquema.tabla&lt;/font&gt;: referencia a otro esquema, revisada por un trigger (no es llave foránea)&lt;br&gt;Línea: pata de gallo en la tabla hija; O = opcional, | = obligatorio. Todas las tablas son de PostgreSQL 17." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFFFFF;strokeColor=#BBBBBB;" vertex="1" parent="1"><mxGeometry x="1180" y="1396" width="760" height="86" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>