eStyle=entityRelationEdgeStyle;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;strokeColor=#4A5568;strokeWidth=1.3;" edge="1" parent="1" source="c135" target="c111"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c148" style="edgeStyle=entityRelationEdgeStyle;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;strokeColor=#4A5568;strokeWidth=1.3;" edge="1" parent="1" source="c80" target="c37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c149" style="edgeStyle=entityRelationEdgeStyle;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;strokeColor=#4A5568;strokeWidth=1.3;" edge="1" parent="1" source="c93" target="c62"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c150" style="edgeStyle=entityRelationEdgeStyle;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;strokeColor=#4A5568;strokeWidth=1.3;" edge="1" parent="1" source="c92" target="c37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c151" style="edgeStyle=entityRelationEdgeStyle;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;strokeColor=#4A5568;strokeWidth=1.3;" edge="1" parent="1" source="c41" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c152" style="edgeStyle=entityRelationEdgeStyle;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;strokeColor=#4A5568;strokeWidth=1.3;" edge="1" parent="1" source="c40" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c153" style="edgeStyle=entityRelationEdgeStyle;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;strokeColor=#4A5568;strokeWidth=1.3;" edge="1" parent="1" source="c39" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c154" value="&lt;b&gt;Restricciones CHECK&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;alerta&lt;/b&gt; · alerta_estado_valido: &lt;font color=&quot;#555555&quot;&gt;(estado IN (&amp;#x27;abierta&amp;#x27;, &amp;#x27;cerrada&amp;#x27;))&lt;/font&gt;&lt;br&gt;&lt;b&gt;alerta&lt;/b&gt; · alerta_tipo_valido: &lt;font color=&quot;#555555&quot;&gt;(tipo IN (&amp;#x27;valor_faltante&amp;#x27;, &amp;#x27;fuera_de_rango&amp;#x27;, &amp;#x27;hueco_anterior&amp;#x27;, &amp;#x27;duplicada&amp;#x27;, &amp;#x27;salto&amp;#x27;, &amp;#x27;no_creciente&amp;#x27;, &amp;#x27;contraste_no_coincide&amp;#x27;, &amp;#x27;valor_productor_usado&amp;#x27;, &amp;#x27;historia_cambi…&lt;/font&gt;&lt;br&gt;&lt;b&gt;aprobacion_serie&lt;/b&gt; · aprobacion_serie_estado_valido: &lt;font color=&quot;#555555&quot;&gt;(estado IN (&amp;#x27;pendiente&amp;#x27;, &amp;#x27;aprobada&amp;#x27;, &amp;#x27;rechazada&amp;#x27;))&lt;/font&gt;&lt;br&gt;&lt;b&gt;comparacion_contraste&lt;/b&gt; · comparacion_contraste_nivel_valido: &lt;font color=&quot;#555555&quot;&gt;(nivel IN (&amp;#x27;mensual&amp;#x27;, &amp;#x27;anual&amp;#x27;))&lt;/font&gt;&lt;br&gt;&lt;b&gt;comparacion_contraste&lt;/b&gt; · comparacion_contraste_resultado_valido: &lt;font color=&quot;#555555&quot;&gt;(resultado IN (&amp;#x27;paso&amp;#x27;, &amp;#x27;pendiente&amp;#x27;, &amp;#x27;fallo&amp;#x27;))&lt;/font&gt;&lt;br&gt;&lt;b&gt;diferencia_version&lt;/b&gt; · diferencia_version_nivel_valido: &lt;font color=&quot;#555555&quot;&gt;(nivel IN (&amp;#x27;mensual&amp;#x27;, &amp;#x27;anual&amp;#x27;))&lt;/font&gt;&lt;br&gt;&lt;b&gt;evento_alerta&lt;/b&gt; · evento_alerta_evento_valido: &lt;font color=&quot;#555555&quot;&gt;(evento IN (&amp;#x27;abierta&amp;#x27;, &amp;#x27;comentada&amp;#x27;, &amp;#x27;cerrada&amp;#x27;, &amp;#x27;reabierta&amp;#x27;))&lt;/font&gt;&lt;br&gt;&lt;b&gt;fuente&lt;/b&gt; · fuente_rol_valido: &lt;font color=&quot;#555555&quot;&gt;(rol IN (&amp;#x27;productor&amp;#x27;, &amp;#x27;canal_acceso&amp;#x27;))&lt;/font&gt;&lt;br&gt;&lt;b&gt;indicador&lt;/b&gt; · indicador_categoria_valida: &lt;font color=&quot;#555555&quot;&gt;(categoria IN (&amp;#x27;economia&amp;#x27;, &amp;#x27;seguridad&amp;#x27;))&lt;/font&gt;&lt;br&gt;&lt;b&gt;observacion&lt;/b&gt; · observacion_estado_contraste_valido: &lt;font color=&quot;#555555&quot;&gt;(estado_contraste IN (&amp;#x27;paso&amp;#x27;, &amp;#x27;pendiente&amp;#x27;, &amp;#x27;no_aplica&amp;#x27;, &amp;#x27;no_disponible&amp;#x27;, &amp;#x27;fallo&amp;#x27;))&lt;/font&gt;&lt;br&gt;&lt;b&gt;observacion&lt;/b&gt; · observacion_estado_valido: &lt;font color=&quot;#555555&quot;&gt;(estado IN (&amp;#x27;en_cuarentena&amp;#x27;, &amp;#x27;aceptada&amp;#x27;))&lt;/font&gt;&lt;br&gt;&lt;b&gt;observacion&lt;/b&gt; · observacion_marcas_validas: &lt;font color=&quot;#555555&quot;&gt;(marcas &amp;lt;@ ARRAY[&amp;#x27;valor_faltante&amp;#x27;, &amp;#x27;fuera_de_rango&amp;#x27;, &amp;#x27;hueco_anterior&amp;#x27;, &amp;#x27;duplicada&amp;#x27;, &amp;#x27;salto&amp;#x27;, &amp;#x27;no_creciente&amp;#x27;, &amp;#x27;contraste_pendiente&amp;#x27;, &amp;#x27;contraste_no_coincide&amp;#x27;, &amp;#x27;sin_segun…&lt;/font&gt;&lt;br&gt;&lt;b&gt;observacion&lt;/b&gt; · observacion_nivel_contraste_valido: &lt;font color=&quot;#555555&quot;&gt;(nivel_contraste IN (&amp;#x27;mensual&amp;#x27;, &amp;#x27;anual&amp;#x27;))&lt;/font&gt;&lt;br&gt;&lt;b&gt;observacion&lt;/b&gt; · observacion_periodo_valido: &lt;font color=&quot;#555555&quot;&gt;(periodo ~ &amp;#x27;^\d{4}(-\d{2}(-\d{2})?)?$&amp;#x27;)&lt;/font&gt;&lt;br&gt;&lt;b&gt;serie&lt;/b&gt; · serie_frecuencia_valida: &lt;font color=&quot;#555555&quot;&gt;(frecuencia IN (&amp;#x27;mensual&amp;#x27;, &amp;#x27;anual&amp;#x27;))&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFFFFF;strokeColor=#BBBBBB;" vertex="1" parent="1"><mxGeometry x="40" y="1116" width="1100" height="311" as="geometry" /></mxCell><mxCell id="c155" value="&lt;b&gt;Reglas que el diagrama no muestra por sí solo&lt;/b&gt;&lt;br&gt;· Triggers de solo inserción en aprobacion_serie, archivo_evidencia, descarga, archivo_original, observacion, comparacion_contraste y evento_alerta.&lt;br&gt;· alerta: solo cambia estado (alerta_solo_cambia_estado, alerta_transicion) y cada cambio exige su evento al confirmar (alerta_cambio_con_evento, diferido).&lt;br&gt;· Índice único parcial alerta_una_abierta_idx: una alerta abierta por (serie_id, periodo, territorio, tipo, valor).&lt;br&gt;· Funciones: observaciones_vigentes, observacion_en, esta_aceptada, serie_aprobada, alertas_abiertas. Procedimientos: cerrar_alerta, reabrir_alerta." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFF6DD;strokeColor=#C5A56A;" vertex="1" parent="1"><mxGeometry x="1180" y="1116" width="760" height="176" as="geometry" /></mxCell><mxCell id="c156" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B07D00&quot;&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; llave primaria · &lt;font color=&quot;#1F5FA8&quot;&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; llave foránea · &lt;font color=&quot;#2E6B4F&quot;&gt;&lt;b&gt;UQ&lt;/b&gt;&lt;/font&gt; único · &lt;font color=&quot;#8F1D2C&quot;&gt;&lt;b&gt;CK&lt;/b&gt;&lt;/font&gt; CHECK · &lt;font color=&quot;#999999&quot;&gt;NULL&lt;/font&gt; admite vacío&lt;br&gt;&lt;font color=&quot;#1F5FA8&quot;&gt;→ esquema.tabla&lt;/font&gt;: referencia a otro esquema, revisada por un trigger (no es llave foránea)&lt;br&gt;Línea: pata de gallo en la tabla hija; O = opcional, | = obligatorio. Todas las tablas son de PostgreSQL 17." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFFFFF;strokeColor=#BBBBBB;" vertex="1" parent="1"><mxGeometry x="1180" y="1321" width="760" height="86" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>