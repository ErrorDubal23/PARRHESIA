illColor=#EAF5EA;strokeColor=#3C8A3C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2387" y="2011" width="96" height="30" as="geometry" /></mxCell><mxCell id="c201" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="c16" target="c200"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c202" value="decision" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EAF5EA;strokeColor=#3C8A3C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2215" y="2035" width="96" height="30" as="geometry" /></mxCell><mxCell id="c203" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="c16" target="c202"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c204" value="motivo" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EAF5EA;strokeColor=#3C8A3C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2080" y="1929" width="96" height="30" as="geometry" /></mxCell><mxCell id="c205" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="c16" target="c204"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c206" value="creado_en" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EAF5EA;strokeColor=#3C8A3C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2329" y="1775" width="96" height="30" as="geometry" /></mxCell><mxCell id="c207" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="c16" target="c206"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c208" value="&lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EAF5EA;strokeColor=#3C8A3C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3117" y="1905" width="96" height="30" as="geometry" /></mxCell><mxCell id="c209" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="c17" target="c208"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c210" value="rol" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EAF5EA;strokeColor=#3C8A3C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2905" y="2041" width="96" height="30" as="geometry" /></mxCell><mxCell id="c211" style="endArrow=none;html=1;strokeColor=#555555;" edge="1" parent="1" source="c17" target="c210"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c212" value="&lt;b&gt;Reglas que el diagrama no muestra por sí solo&lt;/b&gt;&lt;br&gt;· Arco exclusivo: cada afirmación sale de exactamente uno de sus tres textos (publicación, declaración o declaración reportada).&lt;br&gt;· Las verificaciones no se editan: una corrección es una versión nueva y la vigente es la de mayor versión (decisión 5).&lt;br&gt;· Una conclusión distinta de &quot;sin dato comparable&quot; tiene al menos una observación citada; hay serie si y solo si hay dato comparable.&lt;br&gt;· La evidencia solo puede ser una observación vigente y aceptada (nunca en cuarentena), y la serie debe estar aprobada.&lt;br&gt;· Una explicación validada no puede tener una cifra que no esté en la evidencia, en el valor dicho o en los periodos (trigger diferido).&lt;br&gt;· Solo un usuario con rol verificador o admin realiza revisiones humanas.&lt;br&gt;· Una credencial no guarda la llave secreta: solo su alias. Un trabajo tiene salida si y solo si terminó; la misma entrada se resuelve una vez (caché).&lt;br&gt;· Las entidades con borde punteado viven en otros esquemas: la relación la revisa un trigger con una función, no una llave foránea (decisión 1)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFF6DD;strokeColor=#C5A56A;" vertex="1" parent="1"><mxGeometry x="40" y="2250" width="900" height="251" as="geometry" /></mxCell><mxCell id="c213" value="&lt;b&gt;Notación de Chen&lt;/b&gt;&lt;br&gt;Rectángulo: entidad · Rombo: relación · Elipse: atributo&lt;br&gt;&lt;u&gt;Subrayado&lt;/u&gt;: identificador · Elipse punteada: atributo derivado (lo calcula la base) · Doble elipse: atributo multivaluado&lt;br&gt;Doble rectángulo: entidad débil · Doble rombo: relación que la identifica · Subrayado punteado: clave parcial&lt;br&gt;Borde punteado: entidad detallada en otro MER&lt;br&gt;(mín,máx) junto a una entidad: en cuántas relaciones de ese tipo participa cada ejemplar de esa entidad" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFFFFF;strokeColor=#BBBBBB;" vertex="1" parent="1"><mxGeometry x="980" y="2250" width="760" height="131" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>