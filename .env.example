# App token for the Socrata (SODA) API at datos.gov.co.
# Create one at https://www.datos.gov.co/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# Local PostgreSQL (docker-compose.yml). Choose a new password for this local
# database (not your Docker or GitHub password); it never goes to git.
POSTGRES_PASSWORD=
# Host port; 5433 by default so it does not clash with a PostgreSQL already on 5432.
POSTGRES_PORT=5433
# postgresql://app:<POSTGRES_PASSWORD>@127.0.0.1:5433/proyecto_social
DATABASE_URL=

# Local Neo4j (docker-compose.yml). Choose a password of at least 8 characters; it never goes to git.
NEO4J_PASSWORD=
NEO4J_URL=bolt://127.0.0.1:7687

# Secreto para firmar las sesiones (JWT); se genera al azar, nunca va a git.
JWT_SECRETO=
# Llaves de IA por alias (una por cuenta); la base solo guarda el alias.
GROQ_KEY_groq_cuenta_1=

# Contraseñas de los roles de cada servicio (se generan al azar; nunca van a git)
PG_CLAVE_OFICIAL=
PG_CLAVE_SOCIAL=
PG_CLAVE_VERIFICACION=
PG_CLAVE_IA=
PG_CLAVE_TEMAS=
PG_CLAVE_GRAFO=
# Puerto local de la aplicación (puerta de entrada Nginx)
PUERTO_APP=8080

# --- Opcionales (sin ellas la app funciona, sin esa función) -------------------------------------
# Más cuentas de IA por alias: <PROVEEDOR>_KEY_<alias>. El segundo lector del consenso es Gemini si hay
# una cuenta y, si no, OpenRouter (decisión 35). Gemini: https://aistudio.google.com · Groq: https://console.groq.com
# GROQ_KEY_groq_cuenta_2=
# GEMINI_KEY_gemini_1=
# OPENROUTER_KEY_openrouter_1=
# OPENROUTER_KEY_openrouter_2=
# Imagen de cada tema del día (https://unsplash.com/developers)
# UNSPLASH_ACCESS_KEY=
# Verificaciones de otros medios, sin su calificación (Google Fact Check Tools)
# GOOGLE_FACTCHECK_KEY=
# 1 = botones de ejemplos al azar para la presentación (por defecto); 0 = app normal
# MODO_DEMO=1
# true solo detrás de HTTPS (cookie Secure); en local, false
# COOKIE_SEGURA=false
# Puertos locales de Neo4j (Browser y Bolt)
# NEO4J_HTTP_PORT=7474
# NEO4J_BOLT_PORT=7687
